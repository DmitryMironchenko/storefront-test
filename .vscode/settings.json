{
  // Format every file on save with Prettier (owns quotes, spacing, Tailwind class order).
  // Works in desktop VS Code and browser-based VS Code (github.dev / vscode.dev).
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Belt-and-suspenders: also format these explicitly.
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // Apply ESLint's auto-fixable rules on save (separate from formatting).
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Tailwind IntelliSense: autocomplete + conflict linting inside tv() (tailwind-variants / HeroUI).
  "tailwindCSS.classFunctions": ["tv"]
}
